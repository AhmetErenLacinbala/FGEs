{
  "name": "fges",
  "version": "0.1.0",
  "description": "A small, extensible WebGPU rendering engine for the web",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fges.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/fges.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "webgpu",
    "graphics",
    "rendering",
    "3d"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmetErenLacinbala/FGEs.git"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.54",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
